<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Adventurer's Guild Registry</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Eagle+Lake&family=IM+Fell+English:ital@0;1&family=MedievalSharp&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/medieval.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GuildForm.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="tavern-header">
        <div class="container-fluid">
            <div class="row align-items-center py-3">
                <div class="col-md-4">
                    <div class="chancery-seal">
                        <span class="seal-icon">⚜️</span>
                        <h1 class="tavern-title font-cinzel">Royal Chancery</h1>
                        <p class="tavern-subtitle font-medieval">Guild Registry & Petitioner Court</p>
                    </div>
                </div>
                <div class="col-md-8">
                    <nav class="nav nav-pills medieval-nav">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Petition" ? "active" : "")" 
                           asp-area="" asp-controller="Home" asp-action="Petition">
                            <span class="nav-icon">📜</span> Petition Scroll
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "GuildRolls" ? "active" : "")" 
                           asp-area="" asp-controller="Home" asp-action="GuildRolls">
                            <span class="nav-icon">📋</span> Guild Rolls
                        </a>
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Charter" ? "active" : "")" 
                           asp-area="" asp-controller="Home" asp-action="Charter">
                            <span class="nav-icon">⚖️</span> Charter & Decrees
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </header>
    <div class="container-fluid parchment-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="medieval-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="font-fell mb-0" style="color: var(--parchment-bg);">
                        &copy; 2026 - Royal Chancery of the Guild Fellowships
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-area="" asp-controller="Home" asp-action="Charter" 
                       style="color: var(--gold-accent); text-decoration: none; font-family: 'MedievalSharp', cursive;">
                        Charter & Privacy Decrees
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/guild.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
