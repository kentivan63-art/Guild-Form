@{
    ViewData["Title"] = "Charter & Decrees";
}

<div class="parchment-scroll">
    <!-- Corner Flourishes -->
    <div class="corner-flourish corner-flourish-tl">❧</div>
    <div class="corner-flourish corner-flourish-tr">❧</div>
    <div class="corner-flourish corner-flourish-bl">❧</div>
    <div class="corner-flourish corner-flourish-br">❧</div>

    <!-- Header -->
    <div class="text-center mb-4">
        <h1 class="font-cinzel" style="color: var(--ink-heading); font-size: 2rem; margin-bottom: 0.5rem;">
            Guild Charter & Privacy Decrees
        </h1>
        <p class="font-medieval" style="color: var(--ink-faded); font-style: italic; font-size: 1.1rem;">
            Historic Bylaws and Records Protection
        </p>
    </div>

    <!-- Charter Section -->
    <div class="form-section">
        <h2 class="section-title">The Great Charter of 1253</h2>
        
        <div class="font-fell" style="line-height: 1.8; color: var(--ink-color);">
            <p class="mb-3">
                <span class="drop-cap">B</span>y the grace of God and the authority of His Majesty King Henry III, 
                we do hereby establish this Great Charter to govern the Ancient Guild Fellowships of the Realm. 
                This document, sealed with the Royal Signet and affirmed by the Guild Masters, shall stand as 
                the foundation of craft rights, privileges, and responsibilities throughout the kingdom.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Article I: Rights of the Craftsmen
            </h3>
            <p class="mb-3">
                Every free craftsman of good standing shall have the right to practice their art within the 
                borough limits, subject to the oversight of their respective Guild Masters. No man shall be 
                denied the opportunity to learn a trade, provided they demonstrate proper aptitude and moral character.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Article II: Quality Standards
            </h3>
            <p class="mb-3">
                All goods produced by guild members shall meet the quality standards established by the fellowship. 
                Inferior workmanship shall be grounds for fines, suspension, or in grave cases, expulsion from the guild. 
                The Guild Masters shall quarterly inspect all workshops and markets to ensure compliance.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Article III: Apprenticeship Systems
            </h3>
            <p class="mb-3">
                No craftsman shall take more than three apprentices at any given time, ensuring proper training 
                and attention to each student. Apprenticeships shall last no less than seven years, after which 
                the journeyman shall present a masterpiece to the Guild Council for examination.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Article IV: Fair Trade Practices
            </h3>
            <p class="mb-3">
                Price fixing shall be prohibited; however, minimum fair prices shall be established to prevent 
                exploitation of craftsmen. No member shall undercut a fellow guild member to gain unfair advantage. 
                Disputes shall be resolved by the Guild Council within one moon's turn.
            </p>
        </div>
    </div>

    <!-- Privacy Decrees Section -->
    <div class="form-section">
        <h2 class="section-title">Privacy Decrees & Records Protection</h2>
        
        <div class="font-fell" style="line-height: 1.8; color: var(--ink-color);">
            <p class="mb-3">
                <span class="drop-cap">U</span>nder the authority of the Royal Chancery and in accordance with 
                the Data Protection Act of the Realm, we establish these decrees to protect the privacy and 
                dignity of all petitioners and guild members.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Decree I: Collection of Personal Information
            </h3>
            <p class="mb-3">
                The Royal Chancery shall collect only such information as is necessary for the proper 
                administration of guild admissions and record-keeping. Personal information includes name, 
                lineage, town of residence, and craft specialization. Such information shall be stored securely 
                within the Guild Archives and accessed only by authorized officials.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Decree II: Use and Disclosure
            </h3>
            <p class="mb-3">
                Personal information shall be used solely for guild administration, taxation purposes, and 
                the maintenance of craft standards. No information shall be disclosed to third parties without 
                the written consent of the petitioner, except as required by Royal Decree or Court Order.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Decree III: Data Retention
            </h3>
            <p class="mb-3">
                Guild records shall be maintained in perpetuity for historical and administrative purposes. 
                However, petitioners may request the correction of inaccurate information or, in extreme 
                circumstances, the removal of their records from public registry while maintaining archival 
                copies for historical continuity.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Decree IV: Security Measures
            </h3>
            <p class="mb-3">
                The Guild Archives shall be protected by physical locks, magical wards, and trusted scribes. 
                Digital records shall be encrypted and stored in the Royal Cloud, accessible only through 
                authentication by signet ring and spoken passphrase.
            </p>
            
            <h3 class="font-cinzel mt-4 mb-3" style="color: var(--ink-heading); font-size: 1.3rem;">
                Decree V: Rights of the Petitioner
            </h3>
            <p class="mb-3">
                Every petitioner shall have the right to:
            </p>
            <ul style="list-style-type: '❧ '; padding-left: 2rem; margin-bottom: 1rem;">
                <li>Inspect their personal records upon request</li>
                <li>Request correction of erroneous information</li>
                <li>Withdraw their petition at any time prior to guild enrollment</li>
                <li>File complaints with the Guild Ombudsman regarding privacy violations</li>
                <li>Seek redress through the Royal Courts for grievous breaches</li>
            </ul>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="form-section">
        <h2 class="section-title">Contact the Chancery</h2>
        
        <div class="font-fell" style="line-height: 1.8; color: var(--ink-color);">
            <p class="mb-3">
                For inquiries regarding guild admissions, record corrections, or privacy concerns, 
                petitioners may contact the Royal Chancery through the following means:
            </p>
            
            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <h4 class="font-cinzel" style="color: var(--ink-heading);">Physical Address</h4>
                    <p class="mb-0">Royal Chancery Office</p>
                    <p class="mb-0">Tower of London, Ward 3</p>
                    <p class="mb-0">London, EC3N 4AB</p>
                </div>
                <div class="col-md-6 mb-3">
                    <h4 class="font-cinzel" style="color: var(--ink-heading);">Raven Messenger Service</h4>
                    <p class="mb-0">Send missives via carrier raven to:</p>
                    <p class="mb-0 font-script">"Chancery Records, Tower Rock"</p>
                </div>
            </div>
            
            <div class="mt-4">
                <h4 class="font-cinzel" style="color: var(--ink-heading);">Office Hours</h4>
                <p class="mb-0">Monday - Friday: Dawn until Dusk</p>
                <p class="mb-0">Saturday: Morning hours only</p>
                <p class="mb-0">Sunday: Closed for Royal Observance</p>
            </div>
        </div>
    </div>

    <!-- Seal -->
    <div class="text-center mt-4">
        <div style="display: inline-block; width: 100px; height: 100px; 
                    background: radial-gradient(circle at 35% 35%, #a82020, #731212 70%, #4a0a0a);
                    border: 3px solid var(--wax-red-dark);
                    border-radius: 50%;
                    display: flex; align-items: center; justify-content: center;
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);">
            <span style="color: var(--gold-accent); font-family: 'Cinzel Decorative', cursive; font-size: 1.2rem;">
                ⚜️
            </span>
        </div>
        <p class="font-fell mt-2" style="color: var(--ink-faded); font-style: italic;">
            Affixed with the Royal Signet, 1253 AD
        </p>
    </div>
</div>